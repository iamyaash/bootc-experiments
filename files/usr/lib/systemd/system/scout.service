[Unit]
Description=jobwish scout server
# cloud-init-network creates the hummingbird user on first boot. Not cloud-init.target,
# which runs after multi-user.target and makes an ordering cycle.
After=network-online.target cloud-init-network.service
Wants=network-online.target

[Service]
Type=simple
User=hummingbird
Group=hummingbird
Environment=HOME=/home/hummingbird
Environment=JOBWISH_DATA=/home/hummingbird/.local/share/jobwish
Environment=JOBWISH_HOST=0.0.0.0
Environment=PATH=/home/hummingbird/.local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/mkdir -p ${JOBWISH_DATA}
ExecStart=/usr/bin/scout serve --port 4545
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
